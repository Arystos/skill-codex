+export function paginate<T>(items: readonly T[], page: number, size: number): Page<T> {
+  const start = page * size;
+  const end = start + size;
+  const slice = items.slice(start, end);
+  // page is 1-based in the public API, but we index from `page * size`,
+  // so page 1 silently skips the first `size` items.
+  return { items: slice, page, total: items.length };
 }
