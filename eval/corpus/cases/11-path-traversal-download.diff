+export async function download(name: string): Promise<Buffer> {
+  // `name` is user-controlled and joined directly. A value like
+  // "../../etc/passwd" escapes UPLOADS — path.join normalises the "..",
+  // so the read happens outside the intended directory.
+  return readFile(join(UPLOADS, name));
+}
