+export async function writeReport(path: string, rows: string[]): Promise<void> {
+  const handle = await open(path, "w");
+  for (const row of rows) {
+    // If any write rejects (disk full, bad encoding), we return without
+    // reaching close(): the file descriptor leaks. There is no try/finally.
+    await handle.write(row + "\n");
+  }
+  await handle.close();
+}
