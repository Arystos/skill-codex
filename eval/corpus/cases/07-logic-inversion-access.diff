+export function canDelete(session: Session, ownerId: string): boolean {
+  const isOwner = session.userId === ownerId;
+  const isAdmin = session.roles.includes("admin");
+  // Condition inverted: returns true only when the caller is NEITHER owner
+  // nor admin, so strangers can delete and the real owner is denied.
+  return !(isOwner || isAdmin);
