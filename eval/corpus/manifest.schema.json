{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Arystos/skill-codex/eval/corpus/manifest.schema.json",
  "title": "skill-codex eval bug corpus manifest",
  "type": "object",
  "required": ["version", "cases"],
  "additionalProperties": true,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/case" }
    }
  },
  "definitions": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "diff", "language", "category", "file", "line",
        "title", "bug", "correctReviewShouldFlag",
        "expectedSignals", "locationSignals", "minSignalHits"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "diff": { "type": "string" },
        "language": { "type": "string", "enum": ["typescript", "javascript", "python", "go"] },
        "category": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "bug": { "type": "string", "minLength": 1 },
        "correctReviewShouldFlag": { "type": "string", "minLength": 1 },
        "expectedSignals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "locationSignals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "minSignalHits": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
